<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>

    <Version>1.0.0</Version>
    <Product>NcmForge</Product>
    <AssemblyTitle>NcmForge</AssemblyTitle>
    <Description>网易云音乐 NCM 转换器：解密 .ncm 容器并输出带标签的 MP3 / FLAC / MP4 / Matroska，支持 AVS3-P3（Audio Vivid）沉浸声。</Description>
    <Authors>NcmForge contributors</Authors>
    <Copyright>Copyright (C) 2026 NcmForge contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <RepositoryUrl>https://github.com/112012201/ncmforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
