# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo
.vs/
.idea/
.vscode/

# Published binaries.
#
# These are large and reproducible. dist/ in particular contains a bundled ffmpeg of roughly
# 110 MB, which is over GitHub's 100 MB per-file limit and would make the repository unusable to
# clone. Ship releases as release assets instead — see .github/workflows/release.yml.
dist/
publish/
*.publish/

# Bundled third-party binaries. Never commit these: FFmpeg is GPLv3 and is fetched per release.
tools/ffmpeg/
**/tools/ffmpeg/
ffmpeg.exe
ffprobe.exe
ffplay.exe

# Local build caches used on this machine.
.dotnet/
.nuget/

# Test and scratch output
TestResults/
*.trx
*.coverage
.ncmforge-tmp/
output/

# ---------------------------------------------------------------------------
# Never commit media. Sample .ncm files and anything converted from them carry
# third-party copyright, and the repository is public.
# ---------------------------------------------------------------------------
*.ncm
*.mp3
*.flac
*.m4a
*.mka
*.wv
*.opus
*.eac3
*.dts
*.thd
*.lrc

# The icon is generated by scripts/make-icon.ps1, but it is committed so that a
# plain `dotnet build` works without running the script first. *.ico is therefore
# deliberately NOT ignored.

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# A portable copy drops its settings next to the executable; never commit those.
NcmForge.portable
settings.json
